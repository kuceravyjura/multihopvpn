{
  "uid": "homelab-overview",
  "title": "Homelab overview",
  "tags": [
    "homelab"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Now",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Servers reachable over wg-mgmt",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-s2"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-s2"
          },
          "expr": "up{job=\"node\", host!=\"\"}",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Probes OK (both directions)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-s2"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-s2"
          },
          "expr": "sum(probe_success) / count(probe_success)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Alerts firing (excl. Watchdog)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-s2"
      },
      "gridPos": {
        "x": 11,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-s2"
          },
          "expr": "count(ALERTS{alertstate=\"firing\", alertname!=\"Watchdog\"}) or vector(0)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 4,
      "type": "bargauge",
      "title": "Certificate days left",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-s2"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-s2"
          },
          "expr": "(probe_ssl_earliest_cert_expiry - time()) / 86400",
          "legendFormat": "{{probe}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "green",
                "value": 7
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "min": 0,
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 101,
      "type": "row",
      "title": "Servers",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU used",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-s2"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-s2"
          },
          "expr": "100 * (1 - avg by (host) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Memory used",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-s2"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-s2"
          },
          "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Disk used (/)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-s2"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-s2"
          },
          "expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"})",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Network (public interface)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-s2"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-s2"
          },
          "expr": "sum by (host) (rate(node_network_receive_bytes_total{device!~\"lo|wg.*|docker.*|br-.*|veth.*|warp.*\"}[5m])) * 8",
          "legendFormat": "{{host}} in"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-s2"
          },
          "expr": "- sum by (host) (rate(node_network_transmit_bytes_total{device!~\"lo|wg.*|docker.*|br-.*|veth.*|warp.*\"}[5m])) * 8",
          "legendFormat": "{{host}} out"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 102,
      "type": "row",
      "title": "Services and probes",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "state-timeline",
      "title": "Services (green = running)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-s2"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-s2"
          },
          "expr": "label_replace(node_systemd_unit_state{state=\"active\", name=~\"(x-ui|AdGuardHome|nginx|zapret|wg-quick@wg-mgmt|prometheus|prometheus-alertmanager|prometheus-blackbox-exporter)[.]service|(homelab-backup|homelab-watcher)[.]timer\"}, \"unit\", \"$1\", \"name\", \"(.+)[.](service|timer)\")",
          "legendFormat": "{{host}} · {{unit}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "down",
                  "color": "red"
                },
                "1": {
                  "text": "active",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Probe time (Moscow -> Lithuania and back)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-s2"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-s2"
          },
          "expr": "probe_duration_seconds",
          "legendFormat": "{{probe}} (from {{prober}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 103,
      "type": "row",
      "title": "Websites (reach agents, every 10 min)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "table",
      "title": "Can it be opened? (s1-msk/direct = from Moscow, s1-msk/user = Server 1's users, s2-lt/direct = from Lithuania)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-s2"
      },
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 12,
        "h": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-s2"
          },
          "expr": "label_join(homelab_reach_up, \"where\", \"/\", \"host\", \"path\")",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "rowField": "site",
            "columnField": "where",
            "valueField": "Value"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "site\\where": "site"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "blocked",
                  "color": "red",
                  "index": 1
                },
                "1": {
                  "text": "open",
                  "color": "green",
                  "index": 0
                }
              }
            }
          ],
          "custom": {
            "align": "center",
            "cellOptions": {
              "type": "color-background",
              "mode": "basic"
            }
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "site"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              },
              {
                "id": "custom.align",
                "value": "left"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 12,
      "type": "state-timeline",
      "title": "Server 1's users: history per site",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-s2"
      },
      "gridPos": {
        "x": 12,
        "y": 39,
        "w": 12,
        "h": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-s2"
          },
          "expr": "homelab_reach_up{host=\"s1-msk\", path=\"user\"}",
          "legendFormat": "{{site}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "blocked",
                  "color": "red",
                  "index": 1
                },
                "1": {
                  "text": "open",
                  "color": "green",
                  "index": 0
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "rowHeight": 0.8,
        "mergeValues": true,
        "alignValue": "left",
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 104,
      "type": "row",
      "title": "Traffic (from the 3x-ui databases)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 53,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Traffic per user now (one WireGuard inbound per person)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-s2"
      },
      "gridPos": {
        "x": 0,
        "y": 54,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-s2"
          },
          "expr": "sum by (host, remark) (rate(xui_inbound_down_bytes_total{remark!~\"reach probe.*\"}[5m]) + rate(xui_inbound_up_bytes_total{remark!~\"reach probe.*\"}[5m])) * 8 > 1000",
          "legendFormat": "{{host}} · {{remark}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ],
          "sortBy": "Mean",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 16,
      "type": "stat",
      "title": "Last 24 hours per server",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-s2"
      },
      "gridPos": {
        "x": 16,
        "y": 54,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-s2"
          },
          "expr": "sum by (host) (increase(xui_inbound_down_bytes_total{remark!~\"reach probe.*\"}[24h]) + increase(xui_inbound_up_bytes_total{remark!~\"reach probe.*\"}[24h]))",
          "instant": true,
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Relay hop (Server 1 → Server 2)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-s2"
      },
      "gridPos": {
        "x": 16,
        "y": 58,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-s2"
          },
          "expr": "sum(rate(xui_client_down_bytes_total{host=\"s2-lt\",email=\"rurelay\"}[5m]) + rate(xui_client_up_bytes_total{host=\"s2-lt\",email=\"rurelay\"}[5m])) * 8",
          "legendFormat": "relay"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 18,
      "type": "table",
      "title": "VLESS clients: last seen",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-s2"
      },
      "gridPos": {
        "x": 16,
        "y": 63,
        "w": 8,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-s2"
          },
          "expr": "(time() - xui_client_last_online_timestamp_seconds > 0) and xui_client_last_online_timestamp_seconds > 0",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "env": true
            },
            "renameByName": {
              "Value": "seen ago"
            },
            "indexByName": {
              "host": 0,
              "email": 1,
              "inbound": 2,
              "Value": 3
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "seen ago"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 19,
      "type": "table",
      "title": "Traffic per user (download + upload)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-s2"
      },
      "gridPos": {
        "x": 0,
        "y": 63,
        "w": 16,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
