#!/usr/bin/env python3
# Managed by Ansible (role: watcher). Checks each monitoring server; after N failed checks in a
# row, pushes one alert to ntfy.sh; pushes once more when it recovers. Run every minute by a timer.
import json, os, sys, urllib.request

TARGETS = json.load(open('/etc/homelab-watcher.json'))
NTFY = os.environ['NTFY_URL']
N = {{ watcher_failures_before_alert }}
STATE = '/var/lib/homelab-watcher'


def get(url):
    with urllib.request.urlopen(url, timeout=10) as r:
        return json.load(r)


def check(base):
    alerts = get(base + '/api/v1/alerts')['data']['alerts']
    if not any(a['labels'].get('alertname') == 'Watchdog' and a['state'] == 'firing' for a in alerts):
        return 'Prometheus answers but its Watchdog alert is not firing (rules not evaluated?)'
    if not get(base + '/api/v1/alertmanagers')['data']['activeAlertmanagers']:
        return 'Prometheus has no Alertmanager connected: alerts would not be delivered'
    return None


def push(title, body, prio):
    req = urllib.request.Request(NTFY, data=body.encode(), method='POST',
                                 headers={'Title': title, 'Priority': prio, 'Tags': 'homelab'})
    urllib.request.urlopen(req, timeout=15).read()


os.makedirs(STATE, exist_ok=True)
for t in TARGETS:
    path = f"{STATE}/{t['name']}.json"
    st = json.load(open(path)) if os.path.exists(path) else {'fails': 0, 'alerted': False}
    try:
        problem = check(t['url'])
    except Exception as e:                     # unreachable: server, tunnel or Prometheus down
        problem = f'unreachable over wg-mgmt: {e}'
    try:
        if problem:
            st['fails'] += 1
            if st['fails'] >= N and not st['alerted']:
                push(f"Monitoring down: {t['name']}", f"{problem}\n({st['fails']} checks in a row). "
                     'Telegram alerts from it will not arrive until this recovers.', 'high')
                st['alerted'] = True
        else:
            if st['alerted']:
                push(f"Monitoring back: {t['name']}", 'Prometheus and Alertmanager are working again.', 'default')
            st = {'fails': 0, 'alerted': False}
    except Exception as e:                     # push failed: try again next minute
        print(f"push failed: {e}", file=sys.stderr)
        st['alerted'] = False
    json.dump(st, open(path, 'w'))
    print(f"{t['name']}: {'OK' if not problem else problem} (fails={st['fails']}, alerted={st['alerted']})")
